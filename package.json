{
  "name": "music-performance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based music performance game, built on Cloudflare Workers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:validate && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "cf-dry-run": "npm run build && wrangler deploy --dry-run",
    "content:build": "tsx scripts/content/build.ts",
    "content:validate": "tsx scripts/content/validate.ts",
    "content": "npm run content:build && npm run content:validate",
    "test:e2e": "playwright test",
    "content:setup": "tsx scripts/content/setup.ts",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "pitchy": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
